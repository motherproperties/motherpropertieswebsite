# Required for production email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Mother Properties
LEAD_NOTIFICATION_EMAIL=

# Protects GET /api/admin/leads/export/
LEADS_EXPORT_TOKEN=

# Use a long random value for hashed rate-limit identifiers
RATE_LIMIT_SALT=

# Netlify sets NETLIFY=true and supplies Blobs context automatically.
LEAD_STORAGE=

# Optional. Analytics remains disabled until both this is set and a visitor opts in.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Optional Search Console HTML-tag verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required business/compliance facts for production publication.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_REGISTRATION_NUMBER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
